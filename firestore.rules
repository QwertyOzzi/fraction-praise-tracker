rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Главный владелец (вы) — полный контроль над проектом
    function isOwner() {
      return request.auth != null && 
        request.auth.token.email.lower() == 'goponos12@gmail.com';
    }

    // Проверка прав администратора (вы ИЛИ email есть в списке config/admins)
    function isAdmin() {
      return isOwner() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }

    // Таблицы похвалы и отметок: читать может любой, менять — все админы
    match /sheets/{sheetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Список администраторов (config/admins):
    // - Читать могут все (чтобы сайт знал, кому показать кнопки)
    // - Менять список админов может ТОЛЬКО владелец (goponos12@gmail.com)
    match /config/admins {
      allow read: if true;
      allow write: if isOwner();
    }

    // Служба поддержки и баг-репорты: любой пользователь может отправить, админы могут модерировать
    match /support_tickets/{ticketId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
