rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'goponos12@gmail.com';
    }
    function isAdmin() {
      return isOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }
    match /sheets/{sheetId} {
      allow read: if sheetId in ['fractionrp', 'praise'];
      allow write: if isAdmin() && sheetId in ['fractionrp', 'praise'];
    }
    match /config/admins {
      // Reading the entire administrator directory is restricted to approved staff.
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    match /config/settings {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // Immutable audit trail, readable only by the technical owner.
    // Staff may record only their own website edits; Telegram events are
    // written by the bot's authenticated owner identity.
    match /audit_log/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner() || (
        isAdmin()
        && request.resource.data.keys().hasOnly([
          'source', 'action', 'sheet', 'actor', 'actorEmail',
          'actorUid', 'details', 'createdAt'
        ])
        && request.resource.data.source == 'site'
        && request.resource.data.action in [
          'sheet_edit', 'admin_added', 'admin_removed', 'leader_settings',
          'bot_settings', 'ticket_status', 'ticket_deleted', 'notifications_changed'
        ]
        && request.resource.data.actor is string
        && request.resource.data.actor.size() <= 100
        && request.resource.data.actorEmail == request.auth.token.email.lower()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && ((request.resource.data.action == 'sheet_edit'
             && request.resource.data.sheet in ['fractionrp', 'praise'])
          || (request.resource.data.action != 'sheet_edit'
             && request.resource.data.sheet == ''))
        && request.resource.data.createdAt is timestamp
      );
      allow update, delete: if false;
    }
    match /config/bot_state {
      allow read, write: if isOwner();
    }
    match /support_tickets/{ticketId} {
      // Public users must submit tickets through the rate-limited bot API.
      // The bot authenticates as the Firebase owner; staff may also create tickets.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['nick','contact','category','description','screenshot','status','source','createdAt','timestamp','photo_id'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 4000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.screenshot is string && request.resource.data.screenshot.size() <= 1000
        && request.resource.data.status == 'Новое';
      allow read, update, delete: if isAdmin();
    }
  }
}
