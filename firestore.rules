rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Проверка администратора по почте
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['goponos12@gmail.com'];
    }

    // Листы таблицы (fractionrp, praise) — читать может любой, редактировать только админ
    match /sheets/{sheetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Все остальные документы
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
