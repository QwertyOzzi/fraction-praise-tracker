rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'goponos12@gmail.com';
    }
    function isAdmin() {
      return isOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }
    match /sheets/{sheetId} {
      allow read: if sheetId in ['fractionrp', 'praise'];
      allow write: if isAdmin() && sheetId in ['fractionrp', 'praise'];
    }
    match /config/admins {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /config/settings {
      allow read: if true;
      allow write: if isOwner();
    }
    match /config/bot_state {
      allow read, write: if isOwner();
    }
    match /support_tickets/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly(['nick','contact','category','description','screenshot','status','source','createdAt','timestamp']) &&
        request.resource.data.nick is string && request.resource.data.nick.size() <= 80 &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 4000 &&
        request.resource.data.contact is string && request.resource.data.contact.size() <= 200 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 80 &&
        request.resource.data.screenshot is string && request.resource.data.screenshot.size() <= 1000 &&
        request.resource.data.status == 'Новое' &&
        request.resource.data.source == 'site';
      allow read, update, delete: if isAdmin();
    }
  }
}
